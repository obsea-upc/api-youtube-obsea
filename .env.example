YOUTUBE_API_KEY=tu_api_key_de_google_cloud
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx
POLL_INTERVAL=60

# --- Seguridad ---
# Genera cada token con: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
API_TOKENS=jetson-a:CAMBIA_ESTO_TOKEN_LARGO,jetson-b:CAMBIA_ESTO_OTRO_TOKEN

# true SOLO si nginx/Caddy está realmente delante (si no, X-Forwarded-For es falsificable)
BEHIND_PROXY=true

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
EXPENSIVE_LIMIT_REQUESTS=5
EXPENSIVE_LIMIT_WINDOW=3600

# TTL del registro de nodos (segundos sin heartbeat antes de purgar)
REGISTRY_TTL=900

# --- OAuth de solo lectura (necesario para /api/streams/health) ---
# Genera el token una sola vez con: python3 generate_oauth_token.py
# (rutas relativas: funcionan clonado en cualquier carpeta, no hace
# falta que sea exactamente /opt/yt-monitor)
# Puedes REUTILIZAR el mismo client_secret.json que ya usan tus scripts
# de streaming (es el mismo proyecto de Google Cloud) — solo cópialo
# a esta misma carpeta.
YOUTUBE_OAUTH_CLIENT_SECRETS=./client_secret.json
YOUTUBE_OAUTH_TOKEN_PATH=./data/oauth_readonly_token.pickle
